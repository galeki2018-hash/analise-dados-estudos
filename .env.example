# Configuracoes do projeto
# Copie este arquivo para .env e atualize os valores

# Caminho dos dados
DATA_PATH=./dados/
OUTPUT_PATH=./outputs/

# Configuracoes de banco de dados (se aplicavel)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analise_dados
DB_USER=usuario
DB_PASSWORD=senha

# Configuracoes de API (se aplicavel)
API_KEY=sua_chave_aqui
API_URL=https://api.exemplo.com

# Modo de execucao
DEBUG=False
LOG_LEVEL=INFO

# Configuracoes adicionais
RAPIDOS_PORT=8888
